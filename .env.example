# Optional Buzz Desktop → remote relay
# BUZZ_RELAY_URL=ws://127.0.0.1:3000
# BUZZ_RELAY_HTTP=http://127.0.0.1:3000
# BUZZ_AUTO_CONNECT_DEFAULT_RELAY=1

# Stack ports (defaults avoid clash with similar headless tools)
# BD_DISPLAY=101
# BD_VNC_PORT=5911
# BD_NOVNC_PORT=6180
# BD_BIND=127.0.0.1
# BD_BUZZ_CMD=buzz-desktop
